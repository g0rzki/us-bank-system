POSTGRES_DB=usbank
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5433
API_URL=http://localhost:5100
JWT_SECRET=changeme_minimum_32_characters_required!
WEBHOOK_SECRET=changeme_webhook_secret
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
INTEGRATIONS_ACH_URL=http://localhost:8310
INTEGRATIONS_RTP_URL=http://localhost:6002
INTEGRATIONS_FEDNOW_URL=http://localhost:6003
INTEGRATIONS_SWIFT_URL=http://localhost:6004
INTEGRATIONS_CARDS_URL=http://payment-gateway:8000
INTEGRATIONS_BLIK_URL=http://localhost:6006
INTEGRATIONS_KLIK_API_KEY=your_klik_api_key
CARDS_API_KEY=bank-key-us-a
CARDS_HMAC_SECRET=secret-us-a-hmac
CARDS_ADMIN_KEY=admin-secret-key-2026
KLIK_WEBHOOK_SECRET=changeme_klik_webhook_secret
KLIK_ALLOW_UNSIGNED_WEBHOOKS=false

# ACH / FedSystems SFTP (__ = separator sekcji w ASP.NET Core config)
Ach__RoutingNumber=110000000
Ach__LegalName=US Bank A
Ach__CompanyId=110000000
Ach__FrbRoutingNumber=090000515
Ach__FrbName=FRB Tungsten
# SHA256 fingerprint serwera SFTP FedSystems — ustaw w produkcji (zapobiega MITM)
# Format: SHA256:base64string (wynik ssh-keyscan -t ed25519 <host> lub ssh-keygen -lf)
Ach__Sftp__HostFingerprint=
Ach__Sftp__Host=localhost
Ach__Sftp__Port=2221
Ach__Sftp__Username=us-bank-a
Ach__Sftp__PrivateKeyPath=/path/to/payment-settlement-systems/FedSystems/SFTP_Keys/us-bank-a/id_rsa
Ach__PollIntervalSeconds=60
