## ─── Database (PostgreSQL 16) ────────────────────────────────────────
POSTGRES_DB=usbank
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5999                   # host port (5999 avoids conflict with local PG on 5432)

## ─── Application ─────────────────────────────────────────────────────
FRONTEND_PORT=3100                   # host port for React SPA; also sets CORS origin
API_URL=http://localhost:5100        # used by frontend at build time (VITE_API_URL)
JWT_SECRET=changeme_minimum_32_characters_required!
WEBHOOK_SECRET=dev_webhook_secret    # mock-gateways → API webhook auth header
CORS_ORIGIN=http://localhost:3100    # must match FRONTEND_PORT

## ─── Bank Identity ──────────────────────────────────────────────────
# Routing number used by PhoneAliasService (BLIK P2P on-us detection)
Bank__RoutingNumber=021000021

## ─── PaymentSessions — FedNow ────────────────────────────────────────
# Bank identity for FedNow pacs.008 messages (RTN must pass MOD-10)
FedNow__BankRtn=040104018
FedNow__BankLegalName=Baguette Bank

## ─── PaymentSessions — RTP ──────────────────────────────────────────
# Bank identity for TCHSystems RTP registration and pacs.008 messages
Rtp__BankCode=baguette-bank
Rtp__BankRtn=040104018
Rtp__BankLegalName=Baguette Bank

## ─── FedNow MQ ──────────────────────────────────────────────────────
# FedSystems MQ endpoint for our bank (BANK0) — used by FedNowMqGateway
INTEGRATIONS_FEDNOW_MQ_URL=http://host.docker.internal:8770
# FedNow Central endpoint (only for verify-fednow-integration.sh)
FEDNOW_CENTRAL_URL=http://localhost:8514

## ─── TCHSystems (RTP) ───────────────────────────────────────────────
# TCH RTP backend — docker-compose maps to Integrations:RtpTchUrl
INTEGRATIONS_RTP_TCH_URL=http://host.docker.internal:8200
# API key — empty = auto-registers at TCH startup
Rtp__ApiKey=
# Host URL for verify-rtp-integration.sh
TCHSYSTEMS_RTP_URL=http://localhost:8200

## ─── ACH / FedSystems SFTP ──────────────────────────────────────────
Ach__RoutingNumber=040104018
Ach__LegalName=Baguette Bank
Ach__CompanyId=123456789
Ach__FrbRoutingNumber=090000515      # RTN of the Fed Reserve Bank (RDFI)
Ach__FrbName=FRB Tungsten
Ach__Sftp__HostFingerprint=          # SHA256 fingerprint (empty + AllowUnchecked for dev)
Ach__Sftp__AllowUncheckedFingerprint=true
Ach__Sftp__Host=host.docker.internal
Ach__Sftp__Port=2221
Ach__Sftp__Username=baguette-bank
Ach__Sftp__PrivateKeyPath=/app/sftp_keys/id_rsa
Ach__PollIntervalSeconds=60
# ACH Helper URL for verify-ach-integration.sh (FedSystems json-to-ach)
FEDSYSTEMS_ACH_URL=http://localhost:8310

## ─── SWIFT ──────────────────────────────────────────────────────────
# Real SWIFT Middleware on port 3000 (mock on 6004 is legacy, do not use)
INTEGRATIONS_SWIFT_URL=http://host.docker.internal:3000
# OAuth2 credentials — bank-usbkus01 gets bank.bic=USBKUS01XXX
Swift__ClientId=bank-usbkus01
Swift__ClientSecret=secret-usbkus01
Swift__Bic=USBKUS01XXX
Swift__WebhookSecret=dev_swift_webhook_secret

## ─── Cards (Karty-Platnicze) ────────────────────────────────────────
# cards_gateway_app inside Docker network clearing-us-a-karty, port 8000
INTEGRATIONS_CARDS_URL=http://cards_gateway_app:8000
# Host-accessible URL (for test scripts)
INTEGRATIONS_CARDS_URL_HOST=http://localhost:8072
CARDS_API_KEY=bank-key-us-a
CARDS_HMAC_SECRET=secret-us-a-hmac
CARDS_ADMIN_KEY=admin-secret-key-2026

## ─── KLIK (BLIK) ───────────────────────────────────────────────────
# KLIK web service inside Docker network target_klik (hostname 'web', port 8000)
INTEGRATIONS_BLIK_URL=http://web:8000
INTEGRATIONS_KLIK_API_KEY=klik_Aq79cfvR7OOtE9YORfuNMLJhjFCFe-BZL8nIUnQQoS4
KLIK_WEBHOOK_SECRET=changeme_klik_webhook_secret
# true = accept webhooks with X-KLIK-Webhook-Source (KLIK orchestrator)
KLIK_ALLOW_UNSIGNED_WEBHOOKS=true
# Agent key + merchant ID for test-api.sh (simulate_initiate -> real KLIK)
KLIK_AGENT_API_KEY=agent_1_YVKA3lEzqQUJz3b5cQxvNaWlP8DKHNPhhzb1WAQkHnNsPR2XAHVg
KLIK_MERCHANT_ID=e86f6358-d4ee-42ae-9e53-0d5090c58710
# Host URL for verify-blik-integration.sh
KLIK_URL=http://localhost:8000
KLIK_API_KEY=klik_Aq79cfvR7OOtE9YORfuNMLJhjFCFe-BZL8nIUnQQoS4

## ─── Mock Gateway URLs (test scripts only, NOT used by the API) ─────
INTEGRATIONS_ACH_URL=http://localhost:8310
INTEGRATIONS_RTP_URL=http://localhost:6002
INTEGRATIONS_FEDNOW_URL=http://localhost:6003
