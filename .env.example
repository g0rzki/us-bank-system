POSTGRES_DB=usbank
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5999
FRONTEND_PORT=3100
API_URL=http://localhost:5100
JWT_SECRET=changeme_minimum_32_characters_required!
WEBHOOK_SECRET=dev_webhook_secret
CORS_ORIGIN=http://localhost:3100

INTEGRATIONS_ACH_URL=http://localhost:8310
INTEGRATIONS_RTP_URL=http://localhost:6002
INTEGRATIONS_RTP_TCH_URL=http://localhost:8000
# Klucz API banku w systemie TCH RTP — uzyskaj przez POST /banks na ich systemie
Rtp__ApiKey=
INTEGRATIONS_FEDNOW_URL=http://localhost:6003
# W Dockerze API łączy się z SWIFT Middleware przez host.docker.internal
# Lokalnie (poza dockerem) ustaw na http://localhost:3000
INTEGRATIONS_SWIFT_URL=http://host.docker.internal:3000
# SWIFT OAuth2 — bank-usbkus01 dostaje token z bank.bic=USBKUS01XXX
# test-client zwraca bank.bic=PLBKPL01XXX → middleware odrzuca nasz USBKUS01XXX w XML (forbidden_sender_bic)
Swift__ClientId=bank-usbkus01
Swift__ClientSecret=secret-usbkus01
Swift__Bic=USBKUS01XXX
Swift__WebhookSecret=
# W Dockerze: cards_gateway_app jest w sieci clearing-us-a-karty na porcie 8000
# Na hoście (dev lokalny): http://localhost:8072
INTEGRATIONS_CARDS_URL=http://cards_gateway_app:8000
# Adres cards gateway dostępny z hosta (dla test-api.sh)
INTEGRATIONS_CARDS_URL_HOST=http://localhost:8072
# W Dockerze: KLIK web serwis jest w sieci target_klik (hostname 'web', port 8000)
# Na hoście (test-api.sh): http://localhost:8900
INTEGRATIONS_BLIK_URL=http://web:8000
INTEGRATIONS_KLIK_API_KEY=klik_Aq79cfvR7OOtE9YORfuNMLJhjFCFe-BZL8nIUnQQoS4
KLIK_WEBHOOK_SECRET=changeme_klik_webhook_secret
# true = accept webhooks from KLIK orchestrator (which sends X-KLIK-Webhook-Source instead of X-Webhook-Secret)
KLIK_ALLOW_UNSIGNED_WEBHOOKS=true
# KLIK agent key + merchant ID dla test-api.sh (simulate_initiate → real KLIK)
KLIK_AGENT_API_KEY=agent_1_YVKA3lEzqQUJz3b5cQxvNaWlP8DKHNPhhzb1WAQkHnNsPR2XAHVg
KLIK_MERCHANT_ID=e86f6358-d4ee-42ae-9e53-0d5090c58710

# ACH / FedSystems SFTP (__ = separator sekcji w ASP.NET Core config)
Ach__RoutingNumber=110000000
Ach__LegalName="US Bank A"
Ach__CompanyId=110000000
Ach__FrbRoutingNumber=090000515
Ach__FrbName="FRB Tungsten"
Ach__Sftp__HostFingerprint=
Ach__Sftp__AllowUncheckedFingerprint=true
Ach__Sftp__Host=host.docker.internal
Ach__Sftp__Port=2221
Ach__Sftp__Username=us-bank-a
Ach__Sftp__PrivateKeyPath=C:\Users\Jakub\Documents\GitHub\payment-settlement-systems\FedSystems\SFTP_Keys\us-bank-a\id_rsa
Ach__PollIntervalSeconds=60

# Klucze banku US_BANK_A w systemie Karty-Platnicze-Aplikacje-Biznesowe
CARDS_API_KEY=bank-key-us-a
CARDS_HMAC_SECRET=secret-us-a-hmac
CARDS_ADMIN_KEY=admin-secret-key-2026

# RTP / TCHSystems (verify-rtp-integration.sh)
# TCH RTP backend działa na porcie 8000 (rtp_api kontener)
TCHSYSTEMS_RTP_URL=http://localhost:8000
Rtp__BankCode=us-bank-a
Rtp__BankRtn=110000000

# FedNow (verify-fednow-integration.sh)
# INTEGRATIONS_FEDNOW_MQ_URL — MQ us-bank-a (BANK0) w FedSystems, port 8770
INTEGRATIONS_FEDNOW_MQ_URL=http://host.docker.internal:8770
FedNow__BankRtn=110000000
FEDNOW_CENTRAL_URL=http://localhost:8514

# ACH / FedSystems (verify-ach-integration.sh)
FEDSYSTEMS_ACH_URL=http://localhost:8310

# KLIK / BLIK (verify-blik-integration.sh)
# KLIK_URL — port hosta serwisu web KLIK (docker-compose-dev.yml eksponuje 8000)
KLIK_URL=http://localhost:8000
KLIK_API_KEY=klik_Aq79cfvR7OOtE9YORfuNMLJhjFCFe-BZL8nIUnQQoS4